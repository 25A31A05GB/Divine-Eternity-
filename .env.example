# ===================================================================
# Divine's Eternity - Environment Variables Configuration Template
# NOTE: Never commit sensitive keys or secrets directly to version control.
# ===================================================================

# Application Domain & Server Runtime Port
APP_URL=https://divineseternity.com
PORT=3000

# ----------------- Supabase (PostgreSQL Database & Auth) -----------------
# Public client credentials (safe for browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server-Side Only Service Role Key (NEVER expose to client code)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ----------------- Razorpay Payment Gateway (India) -----------------
# Public Razorpay Key ID for client-side checkout modal
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id_here

# Server-side Razorpay Key ID (never exposed to client)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here

# Server-side Secret for HMAC SHA-256 signature verification (Mandatory)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Secret for verifying incoming webhook signatures from Razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ----------------- Storefront Security & Admin -----------------
# Optional custom password for atelier management portal (/admin)
ADMIN_PASSWORD=admin@123

# Bearer secret token for Vercel Cron routes (/api/cron/*)
CRON_SECRET=your_random_secure_cron_secret_string

# ----------------- Cloudflare Turnstile Bot Protection -----------------
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ----------------- Upstash Redis Rate Limiting -----------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ----------------- Shiprocket Courier Logistics -----------------
SHIPROCKET_EMAIL=logistics@divineseternity.com
SHIPROCKET_PASSWORD=your_shiprocket_password_here

# ----------------- Notifications & Messaging -----------------
# Resend API Key for transactional customer receipts & invoices
RESEND_API_KEY=re_your_resend_api_key_here

# WhatsApp Business Provider Integration
ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_API_KEY=your_whatsapp_provider_api_key_here

# ----------------- Optional Analytics & Monitoring -----------------
# Google Analytics 4 Measurement ID
VITE_GA_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID
VITE_META_PIXEL_ID=123456789012345

# Sentry Error Monitoring DSN
VITE_SENTRY_DSN=https://your_key@o000000.ingest.sentry.io/0000000
